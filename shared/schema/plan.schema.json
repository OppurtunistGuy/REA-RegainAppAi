{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steady.app/schema/plan.schema.json",
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "distractions", "schedules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "distractions": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } },
    "keyHolder": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/keyHolder" }] },
    "unlockPolicy": { "$ref": "#/$defs/unlockPolicy" },
    "siteBlocks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" } }
  },
  "$defs": {
    "surface": {
      "type": "object", "additionalProperties": false, "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^(instagram\\.reels|youtube\\.shorts|snapchat\\.spotlight|facebook\\.reels|app:[A-Za-z0-9._]+|site:[a-z0-9.-]+)$" },
        "mode": { "enum": ["hide_section", "block_app"] }
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "days", "start", "end"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "days": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "uniqueItems": true, "minItems": 1 },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "strict": { "type": "boolean", "default": true }
      }
    },
    "keyHolder": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "relation"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string", "maxLength": 60 },
        "relation": { "enum": ["self", "friend", "parent"] }
      }
    },
    "unlockPolicy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "waitSeconds": { "type": "integer", "minimum": 0, "maximum": 600, "default": 30 },
        "requireReason": { "type": "boolean", "default": true },
        "notifyKeyHolder": { "type": "boolean", "default": true },
        "approvalMinutes": { "type": "integer", "minimum": 1, "maximum": 240, "default": 15 }
      }
    }
  }
}
