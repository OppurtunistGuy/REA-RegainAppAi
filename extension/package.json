{
  "name": "steady-extension",
  "version": "0.10.0",
  "private": true,
  "description": "Steady Chrome extension (MV3): hides Shorts/Reels and blocks listed sites during study blocks.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "npm run build:dev && node e2e/extension.e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
